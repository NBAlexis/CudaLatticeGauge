Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CayleyHamiltonU3", "[", "Q_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "c0", ",", "c1", ",", "c2", ",", "S", ",", "R", ",", "th", ",", "g0", 
       ",", "g1", ",", "g2", ",", "u", ",", "v", ",", "w"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c0", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", "Q", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c1", "=", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"Q", ".", "Q"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c2", "=", 
       RowBox[{
        FractionBox["1", "3"], 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"Q", ".", "Q", ".", "Q"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{
        FractionBox["c1", "3"], "-", 
        FractionBox[
         RowBox[{"c0", "^", "2"}], "18"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"R", "=", 
       RowBox[{
        FractionBox["c2", "2"], "-", 
        FractionBox[
         RowBox[{"c0", " ", "c1"}], "3"], "+", 
        FractionBox[
         RowBox[{"c0", "^", "3"}], "27"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"th", "=", 
       RowBox[{"ArcCos", "[", 
        FractionBox["R", 
         RowBox[{"S", "^", 
          RowBox[{"(", 
           RowBox[{"3", "/", "2"}], ")"}]}]], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g0", "=", 
       RowBox[{
        FractionBox["c0", "3"], "+", 
        RowBox[{"2", 
         SqrtBox["S"], 
         RowBox[{"Cos", "[", 
          RowBox[{
           FractionBox["th", "3"], "-", 
           FractionBox[
            RowBox[{"2", "\[Pi]"}], "3"]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g1", "=", 
       RowBox[{
        FractionBox["c0", "3"], "+", 
        RowBox[{"2", 
         SqrtBox["S"], 
         RowBox[{"Cos", "[", 
          FractionBox["th", "3"], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g2", "=", 
       RowBox[{
        FractionBox["c0", "3"], "+", 
        RowBox[{"2", 
         SqrtBox["S"], 
         RowBox[{"Cos", "[", 
          RowBox[{
           FractionBox["th", "3"], "+", 
           FractionBox[
            RowBox[{"2", "\[Pi]"}], "3"]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"u", "=", 
       RowBox[{
        SqrtBox["g0"], "+", 
        SqrtBox["g1"], "+", 
        SqrtBox["g2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"v", "=", 
       RowBox[{
        SqrtBox[
         RowBox[{"g0", " ", "g1"}]], "+", 
        SqrtBox[
         RowBox[{"g0", " ", "g2"}]], "+", 
        SqrtBox[
         RowBox[{"g1", " ", "g2"}]]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
