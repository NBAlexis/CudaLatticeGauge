Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"action1", "[", "m_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"phi", ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ii", "<", "4"}], ",", 
            RowBox[{"testv1", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"testv2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"ii", "-", "3"}], ",", "1"}], "]"}], "]"}]}], "]"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"dmtr", "[", 
        RowBox[{"m", ",", "0.2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "phi", "]"}], ".", 
          RowBox[{"Inverse", "[", 
           RowBox[{
            RowBox[{"d", ".", 
             RowBox[{"ConjugateTranspose", "[", "d", "]"}]}], "+", 
            RowBox[{"0.1", " ", 
             RowBox[{"IdentityMatrix", "[", "6", "]"}]}]}], "]"}], ".", 
          "phi"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"force1", "[", "m_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "v", ",", "vd", ",", "v1", ",", "v2", ",", "vd1", ",", "vd2", ",", 
       "phi", ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ii", "<", "4"}], ",", 
            RowBox[{"testv1", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"testv2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"ii", "-", "3"}], ",", "1"}], "]"}], "]"}]}], "]"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"dmtr", "[", 
        RowBox[{"m", ",", "0.2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"v", "=", 
       RowBox[{
        RowBox[{"Inverse", "[", 
         RowBox[{
          RowBox[{"d", ".", 
           RowBox[{"ConjugateTranspose", "[", "d", "]"}]}], "+", 
          RowBox[{"0.1", " ", 
           RowBox[{"IdentityMatrix", "[", "6", "]"}]}]}], "]"}], ".", 
        "phi"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vd", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "d", "]"}], ".", "v"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v1", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "1"}], "]"}], "]"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v2", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"5", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"6", ",", "1"}], "]"}], "]"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vd1", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vd", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vd", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vd", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "1"}], "]"}], "]"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vd2", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vd", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vd", "[", 
           RowBox[{"[", 
            RowBox[{"5", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vd", "[", 
           RowBox[{"[", 
            RowBox[{"6", ",", "1"}], "]"}], "]"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"vd2", ".", 
          RowBox[{"ConjugateTranspose", "[", "v1", "]"}]}]}], "+", 
        RowBox[{"v2", ".", 
         RowBox[{"ConjugateTranspose", "[", "vd1", "]"}]}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
