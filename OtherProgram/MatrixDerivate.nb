Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"action3", "[", "m_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"phi", ",", "d", ",", "meff"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"meff", "=", 
       RowBox[{"m", ".", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0.3", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
          RowBox[{"0.11", 
           RowBox[{"Inverse", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "m", "]"}], ".", "m"}], "+", 
             RowBox[{"0.12", 
              RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}], "+", 
          RowBox[{"0.21", 
           RowBox[{"Inverse", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "m", "]"}], ".", "m"}], "+", 
             RowBox[{"0.22", 
              RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}]}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ii", "<", "4"}], ",", 
            RowBox[{"testv1", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"testv2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"ii", "-", "3"}], ",", "1"}], "]"}], "]"}]}], "]"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"dmtr", "[", 
        RowBox[{"meff", ",", "0.2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "phi", "]"}], ".", 
          RowBox[{"Inverse", "[", 
           RowBox[{
            RowBox[{"d", ".", 
             RowBox[{"ConjugateTranspose", "[", "d", "]"}]}], "+", 
            RowBox[{"0.1", " ", 
             RowBox[{"IdentityMatrix", "[", "6", "]"}]}]}], "]"}], ".", 
          "phi"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"force3", "[", "m_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Q", ",", "t1", ",", "t2", ",", "meff", ",", "force0"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t1", "=", 
      RowBox[{"Inverse", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "m", "]"}], ".", "m"}], "+", 
        RowBox[{"0.12", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t2", "=", 
      RowBox[{"Inverse", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "m", "]"}], ".", "m"}], "+", 
        RowBox[{"0.22", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Q", "=", 
      RowBox[{
       RowBox[{"0.3", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
       RowBox[{"0.11", " ", "t1"}], "+", 
       RowBox[{"0.21", "t2"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"meff", "=", 
      RowBox[{"m", ".", "Q"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"force0", "=", 
      RowBox[{"force1", "[", "meff", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{"Q", ".", "force0"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0.11", 
           RowBox[{"t1", ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"force0", ".", "m"}], "+", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "m", "]"}], ".", 
               RowBox[{"ConjugateTranspose", "[", "force0", "]"}]}]}], ")"}], 
            ".", "t1"}]}], "+", 
          RowBox[{"0.21", 
           RowBox[{"t2", ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"force0", ".", "m"}], "+", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "m", "]"}], ".", 
               RowBox[{"ConjugateTranspose", "[", "force0", "]"}]}]}], ")"}], 
            ".", "t2"}]}]}], ")"}], ".", 
        RowBox[{"ConjugateTranspose", "[", "m", "]"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.96612765672613*^9, 3.966127686916318*^9}, {
