Cell[CellGroupData[{

Cell["determinant projection", "Subsection",
 CellChangeTimes->{{3.9660977269398727`*^9, 3.9660977548691635`*^9}, {
  3.9661179975515556`*^9, 3.9661180002098045`*^9}, {3.9661184044136777`*^9, 
  3.966118404688873*^9}, {3.966118653898101*^9, 
  3.9661186568204665`*^9}},ExpressionUUID->"2459757c-f692-458f-84ac-\
9073411db283"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"action2", "[", "m_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"phi", ",", "d", ",", "meff"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"meff", "=", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Det", "[", "m", "]"}], 
         RowBox[{"-", 
          FractionBox["1", "3"]}]], "m"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ii", "<", "4"}], ",", 
            RowBox[{"testv1", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"testv2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"ii", "-", "3"}], ",", "1"}], "]"}], "]"}]}], "]"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"dmtr", "[", 
        RowBox[{"meff", ",", "0.2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "phi", "]"}], ".", 
          RowBox[{"Inverse", "[", 
           RowBox[{
            RowBox[{"d", ".", 
             RowBox[{"ConjugateTranspose", "[", "d", "]"}]}], "+", 
            RowBox[{"0.1", " ", 
             RowBox[{"IdentityMatrix", "[", "6", "]"}]}]}], "]"}], ".", 
          "phi"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"force2", "[", "m_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"meff", ",", "force0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"meff", "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Det", "[", "m", "]"}], 
        RowBox[{"-", 
         FractionBox["1", "3"]}]], "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"force0", "=", 
      RowBox[{"force1", "[", "meff", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"Det", "[", "m", "]"}], 
         RowBox[{"-", 
          FractionBox["1", "3"]}]], "force0"}], "-", 
       RowBox[{
        FractionBox["1", "3"], 
        SuperscriptBox[
         RowBox[{"Det", "[", "m", "]"}], 
         RowBox[{"-", 
          FractionBox["1", "3"]}]], " ", 
        RowBox[{"Tr", "[", 
         RowBox[{"m", ".", "force0"}], "]"}], 
        RowBox[{"Inverse", "[", "m", "]"}]}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9661180123930416`*^9, 3.966118095504842*^9}, {
   3.966118135154952*^9, 3.9661181615458655`*^9}, 3.966118203289006*^9, {
   3.9661185080188155`*^9, 3.9661185179685516`*^9}, {3.966118664950467*^9, 
   3.966118763560603*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"b9d1642b-5b71-4ce0-b9e5-f02fba9b5840"],

