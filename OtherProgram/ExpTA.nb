Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"expTA", "[", 
    RowBox[{"ta_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Q", ",", "Q2", ",", "c0", ",", "c0max", ",", "c1", ",", "u", ",", "u2",
        ",", "bMinus", ",", "th", ",", "w", ",", "w2", ",", 
       "\[IndentingNewLine]", "xi", ",", "f2u", ",", "f8u2", ",", "fu2mw2", 
       ",", "cosw", ",", "f3u2", ",", "exp2u", ",", "expm1u", ",", "dnorm", 
       ",", "\[IndentingNewLine]", "h0", ",", "h1", ",", "h2", ",", 
       "\[IndentingNewLine]", "f0", ",", "f1", ",", "f2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Q", "=", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "a", " ", "ta"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Q2", "=", 
       RowBox[{"Q", ".", "Q"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c0", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Det", "[", "Q", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c1", "=", 
       RowBox[{"0.166666666666666666667", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", "Q2", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"u", "=", 
       RowBox[{"Sqrt", "[", "c1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c0max", "=", 
       RowBox[{"2", " ", "u", " ", "u", " ", "u"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bMinus", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"c0", "<", "0"}], ",", 
        RowBox[{
         RowBox[{"c0", "=", 
          RowBox[{"-", "c0"}]}], ";", 
         RowBox[{"bMinus", "=", "1"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"th", "=", 
       FractionBox["c0", "c0max"]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"th", ">", "1"}], ",", 
        RowBox[{"th", "=", "1"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"th", "=", 
       RowBox[{"0.33333333333333333333", 
        RowBox[{"ArcCos", "[", "th", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
       RowBox[{"1.73205080756887729352744634151", 
        RowBox[{"Sin", "[", "th", "]"}], "u"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"u", "=", 
       RowBox[{"u", "*", 
        RowBox[{"Cos", "[", "th", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"u2", "=", 
       RowBox[{"u", "*", "u"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"w2", "=", 
       RowBox[{"w", "*", "w"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "w", "]"}], ">", "0.1"}], ",", 
         FractionBox[
          RowBox[{"Sin", "[", "w", "]"}], "w"], ",", 
         RowBox[{"(", 
          RowBox[{"1.0", "-", 
           RowBox[{"w2", "*", 
            RowBox[{"(", 
             RowBox[{"1.0", "-", 
              RowBox[{"w2", "*", 
               RowBox[{"(", 
                RowBox[{"1.0", "-", 
                 RowBox[{"w2", "*", "0.0238095238095238095238095238095"}]}], 
                ")"}], "*", "0.05"}]}], ")"}], "*", 
            "0.16666666666666666666667"}]}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f2u", "=", 
       RowBox[{"2", " ", "u"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f8u2", " ", "=", " ", 
       RowBox[{"8", " ", "u2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fu2mw2", "=", 
       RowBox[{"u2", "-", "w2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cosw", "=", 
       RowBox[{"Cos", "[", "w", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f3u2", "=", 
       RowBox[{"3", "u2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"exp2u", "=", 
       RowBox[{
        RowBox[{"Cos", "[", "f2u", "]"}], "+", 
        RowBox[{"I", " ", 
         RowBox[{"Sin", "[", "f2u", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expm1u", "=", 
       RowBox[{
        RowBox[{"Cos", "[", "u", "]"}], "-", 
        RowBox[{"I", " ", 
         RowBox[{"Sin", "[", "u", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h0", "=", 
       RowBox[{
        RowBox[{"exp2u", " ", "fu2mw2"}], "+", 
        RowBox[{"expm1u", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f8u2", " ", "cosw"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"f2u", 
              RowBox[{"(", 
               RowBox[{"f3u2", "+", "w2"}], ")"}], "xi"}], ")"}], "I"}]}], 
          ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h1", "=", 
       RowBox[{
        RowBox[{"exp2u", " ", "f2u"}], "-", 
        RowBox[{"expm1u", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f2u", " ", "cosw"}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"f3u2", "-", "w2"}], ")"}], "xi"}], ")"}], "I"}]}], 
          ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h2", "=", 
       RowBox[{"exp2u", "-", 
        RowBox[{"expm1u", 
         RowBox[{"(", 
          RowBox[{"cosw", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"3", " ", "u", " ", "xi"}], ")"}], "I"}]}], ")"}]}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"dnorm", "=", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"f8u2", "+", "fu2mw2"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f0", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"1", "==", "bMinus"}], ",", 
         RowBox[{
          RowBox[{"Conjugate", "[", "h0", "]"}], "dnorm"}], ",", 
         RowBox[{"h0", " ", "dnorm"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f1", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"1", "==", "bMinus"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Conjugate", "[", "h1", "]"}]}], "dnorm"}], ",", 
         RowBox[{"h1", " ", "dnorm"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f2", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"1", "==", "bMinus"}], ",", 
         RowBox[{
          RowBox[{"Conjugate", "[", "h2", "]"}], "dnorm"}], ",", 
         RowBox[{"h2", " ", "dnorm"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Q", "=", 
       RowBox[{"Q", " ", "f1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Q2", "=", 
       RowBox[{"Q2", " ", "f2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Q", "=", 
       RowBox[{"Q", "+", "Q2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Q", "=", 
       RowBox[{"Q", "+", 
        RowBox[{"f0", " ", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "Q", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expTaylar", "[", 
    RowBox[{"x_", ",", "a_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "3", "]"}], "+", 
