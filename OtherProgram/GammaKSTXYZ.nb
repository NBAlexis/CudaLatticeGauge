Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"signtest", "[", 
    RowBox[{"h_", ",", "v_", ",", "add_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"[", "1", "]"}], "]"}], 
      RowBox[{"v", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"[", "2", "]"}], "]"}], 
      RowBox[{"v", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"[", "3", "]"}], "]"}], 
      RowBox[{"v", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], "+", "add"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"signbilinears", "[", 
    RowBox[{"delta_", ",", "v_", ",", "add_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "8"], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"signtest", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sx", ",", "sy", ",", "sz"}], "}"}], ",", "v", ",", "add"}],
         "]"}], 
       RowBox[{"bchi", "[", 
        RowBox[{"sx", ",", "sy", ",", "sz", ",", "0"}], "]"}], 
       RowBox[{"chi", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"sx", "+", 
            RowBox[{"delta", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", "2"}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"sy", "+", 
            RowBox[{"delta", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "2"}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"sz", "+", 
            RowBox[{"delta", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", "2"}], "]"}], ",", "0"}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"sx", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"sy", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"sz", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"signtables", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sx", ",", "sy", ",", "sz"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sx", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sy", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sz", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", "2"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9839185084694567`*^9, 3.983918580384206*^9}, {
