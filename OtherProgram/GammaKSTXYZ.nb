Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"findOffset", "[", 
    RowBox[{"k1_", ",", "k2_", ",", "k3_", ",", "k4_", ",", "sn_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ii", ",", "deltaparam"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deltaparam", "=", 
       RowBox[{"8", 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"mesons", "[", 
             RowBox[{
              RowBox[{"mtrlstall", "[", 
               RowBox[{"[", "k1", "]"}], "]"}], ",", 
              RowBox[{"mtrlstall", "[", 
               RowBox[{"[", "k2", "]"}], "]"}]}], "]"}], "+", 
            RowBox[{"sn", " ", 
             RowBox[{"mesonsoppo", "[", 
              RowBox[{
               RowBox[{"mtrlstall", "[", 
                RowBox[{"[", "k3", "]"}], "]"}], ",", 
               RowBox[{"mtrlstall", "[", 
                RowBox[{"[", "k4", "]"}], "]"}]}], "]"}]}]}], "//", 
           "Simplify"}], ",", 
          RowBox[{"bchi", "[", 
           RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "]"}]}], "]"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"ii", "=", "1"}], ",", 
        RowBox[{"ii", "<=", 
         RowBox[{"Length", "[", "offsettable", "]"}]}], ",", 
        RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"0", "==", 
             RowBox[{"(", 
              RowBox[{"deltaparam", "+", 
               RowBox[{"offsettable", "[", 
                RowBox[{"[", "ii", "]"}], "]"}]}], ")"}]}], "||", 
            RowBox[{"0", "==", 
             RowBox[{"(", 
              RowBox[{"deltaparam", "-", 
               RowBox[{"offsettable", "[", 
                RowBox[{"[", "ii", "]"}], "]"}]}], ")"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Return", "[", 
             RowBox[{"deltaoffsettable", "[", 
              RowBox[{"[", "ii", "]"}], "]"}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
