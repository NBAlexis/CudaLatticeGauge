   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"qalpha", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "8"], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm4", ",", "st"}], "]"}], ".", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm1", ",", "sx"}], "]"}], ".", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm2", ",", "sy"}], "]"}], ".", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm3", ",", "sz"}], "]"}]}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"alpha", ",", "a"}], "]"}], "]"}], 
           RowBox[{"chi", "[", 
            RowBox[{
             RowBox[{"sx", "+", "x"}], ",", 
             RowBox[{"sy", "+", "y"}], ",", 
             RowBox[{"sz", "+", "z"}], ",", 
             RowBox[{"st", "+", "t"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"sx", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"sy", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"sz", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"st", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"alpha", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bqalpha", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "8"], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"Transpose", "[", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"MatrixPower", "[", 
                 RowBox[{"gm4", ",", "st"}], "]"}], ".", 
                RowBox[{"MatrixPower", "[", 
                 RowBox[{"gm1", ",", "sx"}], "]"}], ".", 
                RowBox[{"MatrixPower", "[", 
                 RowBox[{"gm2", ",", "sy"}], "]"}], ".", 
                RowBox[{"MatrixPower", "[", 
                 RowBox[{"gm3", ",", "sz"}], "]"}]}], ")"}], "]"}], "]"}], 
            "[", 
            RowBox[{"[", 
             RowBox[{"alpha", ",", "a"}], "]"}], "]"}], 
           RowBox[{"bchi", "[", 
            RowBox[{
             RowBox[{"sx", "+", "x"}], ",", 
             RowBox[{"sy", "+", "y"}], ",", 
             RowBox[{"sz", "+", "z"}], ",", 
             RowBox[{"st", "+", "t"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"sx", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"sy", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"sz", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"st", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"alpha", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "  ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaList", "=", 
     RowBox[{"{", 
      RowBox[{"gm1", ",", "gm2", ",", "gm3", ",", "gm4"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tauList", "=", 
     RowBox[{"{", 
      RowBox[{"tau1", ",", "tau2", ",", "tau3", ",", "tau4"}], "}"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"eta", "[", 
      RowBox[{"h_", ",", "mu_"}], "]"}], ":=", 
     RowBox[{"Product", "[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"h", "[", 
         RowBox[{"[", "n", "]"}], "]"}]], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"mu", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xi", "[", 
      RowBox[{"h_", ",", "mu_"}], "]"}], ":=", 
