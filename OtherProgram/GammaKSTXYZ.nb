Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fullbilinears", "[", 
    RowBox[{"delta_", ",", "v_", ",", "add_", ",", "teo_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "16"], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"signtest", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sx", ",", "sy", ",", "sz"}], "}"}], ",", "v", ",", "add"}],
         "]"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"teo", " ", "st"}]], 
       RowBox[{"bchi", "[", 
        RowBox[{"sx", ",", "sy", ",", "sz", ",", "st"}], "]"}], 
       RowBox[{"chi", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"sx", "+", 
            RowBox[{"delta", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", "2"}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"sy", "+", 
            RowBox[{"delta", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "2"}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"sz", "+", 
            RowBox[{"delta", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", "2"}], "]"}], ",", "st"}],
         "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"sx", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"sy", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"sz", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"st", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9839561979199543`*^9, 3.9839562277878714`*^9}, {
  3.983956583833411*^9, 3.9839565872588196`*^9}},
 CellLabel->
