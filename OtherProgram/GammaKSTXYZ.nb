Cell[BoxData[{
 RowBox[{
  RowBox[{"mtrlstall", "=", 
   RowBox[{"{", 
    RowBox[{"gm5", ",", 
     RowBox[{"gm4", ".", "gm5"}], ",", "gm1", ",", "gm2", ",", "gm3", ",", 
     RowBox[{"gm1", ".", "gm5"}], ",", 
     RowBox[{"gm2", ".", "gm5"}], ",", 
     RowBox[{"gm3", ".", "gm5"}], ",", 
     RowBox[{"gm1", ".", "gm4"}], ",", 
     RowBox[{"gm2", ".", "gm4"}], ",", 
     RowBox[{"gm3", ".", "gm4"}], ",", "id4", ",", "gm4", ",", 
     RowBox[{"gm1", ".", "gm2"}], ",", 
     RowBox[{"gm1", ".", "gm3"}], ",", 
     RowBox[{"gm2", ".", "gm3"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mtrnameall", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<g5\>\"", ",", "\"\<g4.g5\>\"", ",", "\"\<g1\>\"", ",", "\"\<g2\>\"", 
     ",", "\"\<g3\>\"", ",", "\"\<g1.g5\>\"", ",", "\"\<g2.g5\>\"", ",", 
     "\"\<g3.g5\>\"", ",", "\"\<g1.g4\>\"", ",", "\"\<g2.g4\>\"", ",", 
     "\"\<g3.g4\>\"", ",", "\"\<1\>\"", ",", "\"\<g4\>\"", ",", 
     "\"\<g1.g2\>\"", ",", "\"\<g1.g3\>\"", ",", "\"\<g2.g3\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bqalphatxyzwithsign", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "8"], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{"Transpose", "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm4", ",", "st"}], "]"}], ".", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm1", ",", "sx"}], "]"}], ".", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm2", ",", "sy"}], "]"}], ".", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"gm3", ",", "sz"}], "]"}]}], ")"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"alpha", ",", "a"}], "]"}], "]"}], 
         RowBox[{"bchi", "[", 
          RowBox[{
           RowBox[{"sx", "+", "x"}], ",", 
           RowBox[{"sy", "+", "y"}], ",", 
           RowBox[{"sz", "+", "z"}], ",", 
           RowBox[{"st", "+", "t"}]}], "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"st", "+", "t"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"sx", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"sy", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"sz", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"st", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"alpha", ",", "1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", "4"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mesonsoppo", "[", 
    RowBox[{"g1_", ",", "g2_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"bqalphatxyzwithsign", "[", 
         RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "]"}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"a1", ",", "alpha1"}], "]"}], "]"}], 
      RowBox[{"g1", "[", 
       RowBox[{"[", 
        RowBox[{"alpha1", ",", "alpha2"}], "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"Conjugate", "[", "g2", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"a1", ",", "a2"}], "]"}], "]"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"qalphatxyz", "[", 
         RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "]"}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"alpha2", ",", "a2"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"alpha1", ",", "1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"alpha2", ",", "1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a1", ",", "1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a2", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}]}], "Input",
